{
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "research.capability.v2",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "project_id": {
      "pattern": "^rp-[0-9a-f]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "capability",
    "project_id"
  ],
  "title": "Request",
  "type": "object"
}